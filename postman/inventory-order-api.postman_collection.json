{
  "info": {
    "_postman_id": "2a1e7ac0-12ea-4d90-b494-12ab34cd56ef",
    "name": "Inventory & Order API",
    "description": "Complete request collection for the Inventory & Order REST API. Login, product creation, and order creation automatically save their returned values.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000" },
    { "key": "token", "value": "" },
    { "key": "productId", "value": "" },
    { "key": "orderId", "value": "" }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health check",
          "auth": { "type": "noauth" },
          "request": { "method": "GET", "url": "{{baseUrl}}/api/health" }
        }
      ]
    },
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Register",
          "auth": { "type": "noauth" },
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Ada Lovelace\",\n  \"email\": \"ada@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/register"
          }
        },
        {
          "name": "Login",
          "auth": { "type": "noauth" },
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "const json = pm.response.json();",
                "if (json.data?.token) pm.collectionVariables.set('token', json.data.token);"
              ],
              "type": "text/javascript"
            }
          }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"ada@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/login"
          }
        }
      ]
    },
    {
      "name": "Products",
      "item": [
        {
          "name": "Create product",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "const json = pm.response.json();",
                "if (json.data?._id) pm.collectionVariables.set('productId', json.data._id);"
              ],
              "type": "text/javascript"
            }
          }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"iPhone 17\",\n  \"description\": \"Flagship smartphone\",\n  \"price\": 999.99,\n  \"stockQuantity\": 10,\n  \"category\": \"electronics\"\n}"
            },
            "url": "{{baseUrl}}/api/products"
          }
        },
        {
          "name": "Get all products",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/products" }
        },
        {
          "name": "Search products",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/products?search=iphone" }
        },
        {
          "name": "Filter by category",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/products?category=electronics" }
        },
        {
          "name": "Filter by stock availability",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/products?inStock=true" }
        },
        {
          "name": "Paginate products",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/products?page=1&limit=10" }
        },
        {
          "name": "Get product by ID",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/products/{{productId}}" }
        },
        {
          "name": "Update product",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"price\": 949.99,\n  \"stockQuantity\": 12\n}" },
            "url": "{{baseUrl}}/api/products/{{productId}}"
          }
        }
      ]
    },
    {
      "name": "Orders",
      "item": [
        {
          "name": "Create order",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "const json = pm.response.json();",
                "if (json.data?._id) pm.collectionVariables.set('orderId', json.data._id);"
              ],
              "type": "text/javascript"
            }
          }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    {\n      \"product\": \"{{productId}}\",\n      \"quantity\": 2\n    }\n  ]\n}"
            },
            "url": "{{baseUrl}}/api/orders"
          }
        },
        {
          "name": "Get logged-in user's orders",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/orders?page=1&limit=10" }
        },
        {
          "name": "Get order by ID",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/orders/{{orderId}}" }
        }
      ]
    },
    {
      "name": "Cleanup (run last)",
      "item": [
        {
          "name": "Delete product",
          "request": { "method": "DELETE", "url": "{{baseUrl}}/api/products/{{productId}}" }
        }
      ]
    }
  ]
}
